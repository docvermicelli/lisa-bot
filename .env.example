# Discord Bot Configuration
DISCORD_TOKEN=your_bot_token_here
DISCORD_CLIENT_ID=1566393474578649188
DISCORD_GUILD_ID=your_private_server_id_here
DISCORD_CHANNEL_ID=your_private_channel_id_here

# LLM Provider Selection
# Set USE_GROQ=true to use Groq API (FREE, blazing fast LPU inference)
# Set USE_GROQ=false to use local Ollama (unlimited, private, slower on CPU)
USE_GROQ=true

# Groq Configuration (Get API key from https://console.groq.com)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GROQ_TEMPERATURE=0.85
GROQ_TOP_P=0.95
GROQ_MAX_TOKENS=2048

# Ollama Configuration (Local LLM - Unlimited & Free!)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
OLLAMA_TEMPERATURE=0.85
OLLAMA_TOP_P=0.95
OLLAMA_MAX_TOKENS=2048

# Memory Configuration
MEMORY_DB_PATH=./data/lisa-memory.db
MAX_CONVERSATION_HISTORY=50
MAX_MEMORY_ENTRIES=1000

# Bot Personality
# Options: mature, friendly, cool, shy, genki, custom
BOT_NAME=Lisa
BOT_PERSONALITY=mature
RESPONSE_LANGUAGE=en

# Relationship Meter Configuration
RELATIONSHIP_ENABLED=true
RELATIONSHIP_POINTS_PER_MESSAGE=2
RELATIONSHIP_POINTS_PER_MENTION=5
RELATIONSHIP_POINTS_PER_LONG_MESSAGE=3
RELATIONSHIP_LONG_MESSAGE_THRESHOLD=100
RELATIONSHIP_STRANGER_MAX=50
RELATIONSHIP_ACQUAINTANCE_MAX=150
RELATIONSHIP_FRIENDS_MAX=400
RELATIONSHIP_CLOSE_FRIENDS_MAX=1000

# Logging
LOG_LEVEL=info
LOG_PRETTY=true

# Performance
MESSAGE_CACHE_SIZE=100
TYPING_INDICATOR=true